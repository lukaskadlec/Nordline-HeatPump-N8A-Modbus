    {
        "id": "a671a68f7d9c1dfb",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "Create HA mqtt device",
        "func": "// --- Configuration ---\nconst baseTopic = \"nodered/heatpump\";\nconst discoveryPrefix = \"homeassistant\";\nconst deviceName = \"Heat Pump\"; \nconst deviceIdentifier = \"nodered_heatpump_001\"; \nconst stateTopic = `${baseTopic}/${deviceIdentifier}/state`;\n\n// Map: JSON Key -> HA Configuration\nconst sensorMap = {\n    // --- Analog Sensors (Numbers) ---\n    \"Teplota vstup\": { unit: \"°C\", devClass: \"temperature\", name: \"Inlet Temp\", icon: \"mdi:thermometer-chevron-down\" },\n    \"Teplota vystup\": { unit: \"°C\", devClass: \"temperature\", name: \"Outlet Temp\", icon: \"mdi:thermometer-chevron-up\" },\n    \"Teplota vytlak\": { unit: \"°C\", devClass: \"temperature\", name: \"Discharge Temp\", icon: \"mdi:thermometer-alert\" },\n    \"Teplota bojler\": { unit: \"°C\", devClass: \"temperature\", name: \"Boiler Temp\", icon: \"mdi:water-boiler\" },\n    \"Teplota sani\": { unit: \"°C\", devClass: \"temperature\", name: \"Suction Temp\", icon: \"mdi:thermometer-low\" },\n    \"Teplota vyparnik\": { unit: \"°C\", devClass: \"temperature\", name: \"Evaporator Temp\", icon: \"mdi:snowflake-thermometer\" },\n    \"Teplota okoli\": { unit: \"°C\", devClass: \"temperature\", name: \"Ambient Temp\", icon: \"mdi:thermometer\" },\n    \"Teplota invertoru\": { unit: \"°C\", devClass: \"temperature\", name: \"Inverter Temp\", icon: \"mdi:chip\" },\n    \"Hodnota ochrane teploty modulu\": { unit: \"°C\", devClass: \"temperature\", name: \"Module Prot. Temp\", icon: \"mdi:shield-alert\" },\n    \"Prehrati sani\": { unit: \"°C\", devClass: \"temperature\", name: \"Superheat Suction\", icon: \"mdi:thermometer-lines\" },\n    \"Prehrati vytlak\": { unit: \"°C\", devClass: \"temperature\", name: \"Superheat Discharge\", icon: \"mdi:thermometer-lines\" },\n    \n    \"Tlak sani\": { unit: \"bar\", devClass: \"pressure\", name: \"Suction Pressure\", icon: \"mdi:gauge-low\" },\n    \"Tlak vytlak\": { unit: \"bar\", devClass: \"pressure\", name: \"Discharge Pressure\", icon: \"mdi:gauge\" },\n    \n    \"Frekvence nastavena\": { unit: \"Hz\", devClass: \"frequency\", name: \"Freq Set\", icon: \"mdi:sine-wave\" },\n    \"Frekvence skutecna\": { unit: \"Hz\", devClass: \"frequency\", name: \"Freq Actual\", icon: \"mdi:sine-wave\" },\n    \n    \"Ventilator rychlost\": { unit: \"rpm\", icon: \"mdi:fan\", name: \"Fan Speed\" },\n    \"Ventilator nastavena rychlost\": { unit: \"rpm\", icon: \"mdi:fan\", name: \"Fan Speed Set\" },\n    \n    \"AC vstupni napeti\": { unit: \"V\", devClass: \"voltage\", name: \"AC Input Volt\", icon: \"mdi:lightning-bolt\" },\n    \"Napeti sbernice\": { unit: \"V\", devClass: \"voltage\", name: \"Bus Volt\", icon: \"mdi:flash\" },\n    \n    \"AC vstupni proud\": { unit: \"A\", devClass: \"current\", name: \"AC Input Curr\", icon: \"mdi:current-ac\" },\n    \"Fazovy proud kompresoru\": { unit: \"A\", devClass: \"current\", name: \"Compressor Curr\", icon: \"mdi:current-ac\" },\n    \n    \n\n    // --- Digital Sensors (Switches) ---\n    // component: \"binary_sensor\" tells the loop to format this as a switch (On/Off)\n    \"Compressor (O01)\": { component: \"binary_sensor\", name: \"Status Compressor\", icon: \"mdi:air-conditioner\" },\n    \"Water Pump (O02)\": { component: \"binary_sensor\", name: \"Status Water Pump\", icon: \"mdi:water-pump\" },\n    \"4-way Valve (O03)\": { component: \"binary_sensor\", name: \"Status 4-way Valve\", icon: \"mdi:valve\" },\n    \"Fan Motor (O04)\": { component: \"binary_sensor\", name: \"Status Fan Motor\", icon: \"mdi:fan\" },\n    \"Antifreeze Heating Strip (O06)\": { component: \"binary_sensor\", name: \"Status Antifreeze Heat\", icon: \"mdi:heating-coil\" },\n    \"Crank Antifreeze Heating Strip (O07)\": { component: \"binary_sensor\", name: \"Status Crank Heat\", icon: \"mdi:heating-coil\" },\n    \"Spray Valve (O08)\": { component: \"binary_sensor\", name: \"Status Spray Valve\", icon: \"mdi:spray\" },\n    \"Auxiliary Electric Heater (O09)\": { component: \"binary_sensor\", name: \"Status Aux Heater\", icon: \"mdi:patio-heater\" },\n    \"Alarm (O11)\": { component: \"binary_sensor\", devClass: \"problem\", name: \"Status Alarm\", icon: \"mdi:alert-circle\" },\n    \"Hot Water Pump (O12)\": { component: \"binary_sensor\", name: \"Status Hot Water Pump\", icon: \"mdi:water-pump\" },\n    \"3-way Valve (O13)\": { component: \"binary_sensor\", name: \"Status 3-way Valve\", icon: \"mdi:valve\" },\n    \"EVV\": { icon: \"mdi:pipe-valve\", name: \"Exp Valve\" },\n\n    \"ON/OFF\": { name: \"ON/OFF\", icon: \"mdi:ower\" },\n};\n\n// --- Logic ---\nvar configMessages = [];\n\nfor (const [jsonKey, config] of Object.entries(sensorMap)) {\n    // 1. Determine Component Type (sensor vs binary_sensor)\n    let component = config.component || \"sensor\"; \n\n    // 2. Create a safe unique ID\n    // Removes spaces, parenthesis, and special chars for the ID\n    let safeId = jsonKey.toLowerCase().replace(/[^a-z0-9]/g, '_').replace(/_+/g, '_'); \n    let uniqueId = `${deviceIdentifier}_${safeId}`;\n    \n    // 3. Create a clean Object ID for entity registry\n    // e.g., hp_inlet_temp or hp_status_compressor\n    let objectId = `hp_${config.name.toLowerCase().replace(/[^a-z0-9]/g, '_').replace(/_+/g, '_')}`;\n\n    // 4. Set Discovery Topic based on component type\n    let configTopic = `${discoveryPrefix}/${component}/${uniqueId}/config`;\n\n    // 5. Build Base Payload\n    let payload = {\n        \"name\": config.name,\n        \"unique_id\": uniqueId,\n        \"object_id\": objectId,\n        \"state_topic\": stateTopic,\n        \"value_template\": `{{ value_json['${jsonKey}'] }}`,\n        \"device\": {\n            \"identifiers\": [deviceIdentifier],\n            \"name\": deviceName,\n            \"model\": \"Heat Pump Controller\",\n            \"manufacturer\": \"Node-RED\"\n        }\n    };\n\n    // 6. Add component-specific details\n    if (component === \"binary_sensor\") {\n        // Binary sensors handle True/False values\n        // We strictly define what the JSON payload looks like for On/Off\n        payload.payload_on = true;\n        payload.payload_off = false;\n        \n        if (config.devClass) payload.device_class = config.devClass;\n        if (config.icon) payload.icon = config.icon;\n        \n    } else {\n        // Standard numeric sensors\n        payload.state_class = \"measurement\";\n        if (config.unit) payload.unit_of_measurement = config.unit;\n        if (config.devClass) payload.device_class = config.devClass;\n        if (config.icon) payload.icon = config.icon;\n    }\n\n    configMessages.push({\n        topic: configTopic,\n        payload: JSON.stringify(payload),\n        retain: true\n    });\n}\n\nreturn [configMessages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
