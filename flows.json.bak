    {
        "id": "ee8e5af9efeab9fc",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "Find new msg types",
        "func": "var sequence1 = [0, 16, 7];\nvar sequence2 = [0, 16, 8];\n\nvar sequence3 = [1, 3, 11];\nvar sequence4 = [1, 3, 42];\nvar sequence5 = [1, 3, 4];\nvar sequence6 = [1, 3, 3];\nvar sequence7 = [1, 3, 180];\n\nvar sequence8 = [4, 3, 3];\nvar sequence9 = [4, 3, 28];\nvar sequence10 = [4, 16, 3];\n\nvar sequence11 = [2, 3, 11];\nvar sequence12 = [5, 3, 3];\n\n\nif (msg.payload) {\n    var isMatchSequence1 = true;\n    var isMatchSequence2 = true;\n    var isMatchSequence3 = true;\n    var isMatchSequence4 = true;\n    var isMatchSequence5 = true;\n    var isMatchSequence6 = true;\n    var isMatchSequence7 = true;\n    var isMatchSequence8 = true;\n    var isMatchSequence9 = true;\n    var isMatchSequence10 = true;\n    var isMatchSequence11 = true;\n    var isMatchSequence12 = true;\n\n    // Check for sequence 1\n    for (var i = 0; i < sequence1.length; i++) {\n        if (msg.payload[i] !== sequence1[i]) {\n            isMatchSequence1 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 2\n    for (var i = 0; i < sequence2.length; i++) {\n        if (msg.payload[i] !== sequence2[i]) {\n            isMatchSequence2 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 3\n    for (var i = 0; i < sequence3.length; i++) {\n        if (msg.payload[i] !== sequence3[i]) {\n            isMatchSequence3 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 4\n    for (var i = 0; i < sequence4.length; i++) {\n        if (msg.payload[i] !== sequence4[i]) {\n            isMatchSequence4 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 5\n    for (var i = 0; i < sequence5.length; i++) {\n        if (msg.payload[i] !== sequence5[i]) {\n            isMatchSequence5 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 6\n    for (var i = 0; i < sequence6.length; i++) {\n        if (msg.payload[i] !== sequence6[i]) {\n            isMatchSequence6 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 7\n    for (var i = 0; i < sequence7.length; i++) {\n        if (msg.payload[i] !== sequence7[i]) {\n            isMatchSequence7 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 8\n    for (var i = 0; i < sequence8.length; i++) {\n        if (msg.payload[i] !== sequence8[i]) {\n            isMatchSequence8 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 9\n    for (var i = 0; i < sequence9.length; i++) {\n        if (msg.payload[i] !== sequence9[i]) {\n            isMatchSequence9 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 10\n    for (var i = 0; i < sequence10.length; i++) {\n        if (msg.payload[i] !== sequence10[i]) {\n            isMatchSequence10 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 11\n    for (var i = 0; i < sequence11.length; i++) {\n        if (msg.payload[i] !== sequence11[i]) {\n            isMatchSequence11 = false;\n            break;\n        }\n    }\n\n    // Check for sequence 12\n    for (var i = 0; i < sequence12.length; i++) {\n        if (msg.payload[i] !== sequence12[i]) {\n            isMatchSequence12 = false;\n            break;\n        }\n    }            \n\n    // Check if any of the sequences match\n    if (isMatchSequence1 || isMatchSequence2 || isMatchSequence3 || isMatchSequence4 || isMatchSequence5 || isMatchSequence6 || isMatchSequence7 || isMatchSequence8 || isMatchSequence9 || isMatchSequence10 || isMatchSequence11 || isMatchSequence12) {\n        // The message starts with one of the specified sequences\n        // You can perform further actions or send the message to the next node\n        return null;\n    }\n}\n\n// The message does not start with the specified sequences\n// You can choose to discard the message or send it to a different node\nreturn msg;\n",
