    {
        "id": "3336ba1e5b1210bb",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "Values for mqtt",
        "func": "// --- Configuration ---\n// Must match the topic used in Node 1\nconst deviceIdentifier = \"nodered_heatpump_001\";\nconst stateTopic = `nodered/heatpump/${deviceIdentifier}/state`;\n\n// --- Logic ---\n// Ensure payload is an object before sending\nlet data = msg.payload;\n\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"Payload is not valid JSON\");\n        return null;\n    }\n}\n\n// Return message formatted for MQTT Out node\nreturn {\n    topic: stateTopic,\n    payload: JSON.stringify(data), // Send the whole JSON object\n    retain: false // Usually sensor updates should not be retained, but config MUST be\n};",
