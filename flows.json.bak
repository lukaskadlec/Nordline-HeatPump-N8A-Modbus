    {
        "id": "be57d15453704866",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "function 2",
        "func": "// Get the previous payload stored in the context\nvar lastPayload = context.get(\"lastPayload\");\n\n// Get the current local time string\n// Note: This relies on the system time/locale of the server running Node-RED\nvar localTime = new Date().toLocaleString(); \n\n// --- FIRST RUN CHECK ---\nif (lastPayload === undefined) {\n    context.set(\"lastPayload\", msg.payload);\n    \n    // Create a new object to ensure timestamp is the very first key\n    var initialPass = { \"timestamp\": localTime };\n    \n    // Copy all properties from the original payload\n    for (var k in msg.payload) {\n        if (msg.payload.hasOwnProperty(k)) {\n            initialPass[k] = msg.payload[k];\n        }\n    }\n    \n    msg.payload = initialPass;\n    return msg;\n}\n\n// --- CHANGE DETECTION ---\n\n// We use a temporary object 'diffs' to collect changes first\nvar diffs = {};\nvar hasChanged = false;\n\n// Loop through every key in the new payload\nfor (var key in msg.payload) {\n    if (msg.payload.hasOwnProperty(key)) {\n        // Compare new value vs old value\n        if (msg.payload[key] != lastPayload[key]) {\n            diffs[key] = {\n                \"old\": lastPayload[key],\n                \"new\": msg.payload[key]\n            };\n            hasChanged = true;\n        }\n    }\n}\n\n// Update the context for next time\ncontext.set(\"lastPayload\", msg.payload);\n\n// --- OUTPUT CONSTRUCTION ---\n\nif (hasChanged) {\n    // Create the final object and add timestamp FIRST\n    var finalOutput = {};\n    finalOutput[\"timestamp\"] = localTime;\n    \n    // Now add the detected changes into this object\n    for (var changeKey in diffs) {\n        finalOutput[changeKey] = diffs[changeKey];\n    }\n\n    msg.payload = finalOutput;\n    return msg;\n} else {\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1160,
        "y": 200,
        "wires": [
            [
                "b0a712e73bdbccb7",
                "3165ad080699a02a"
            ]
        ]
    },
