    {
        "id": "a4f43076dcc02bc7",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "new msg capture",
        "func": "// Get the previous payload stored in the context\nvar lastPayload = context.get(\"lastPayload\");\n\n// Convert current payload to a string for easy comparison\n// (Comparing arrays directly [1,2] === [1,2] returns false in JS)\nvar currentString = JSON.stringify(msg.payload);\n\n// Check if this is the first run OR if the data has changed\nif (lastPayload === undefined || currentString !== lastPayload) {\n    // It's new! Save this as the new \"last\" payload\n    context.set(\"lastPayload\", currentString);\n    \n    // Pass the message along\n    return msg;\n} else {\n    // It's the same. Block the message (return null)\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1310,
        "y": 400,
        "wires": [
            [
                "format_node_01"
            ]
        ]
    },
    {
        "id": "format_node_01",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "Format for File (Time + String)",
        "func": "// 1. Create a clean timestamp (YYYY-MM-DD HH:mm:ss)\nvar now = new Date();\nvar timeStamp = now.getFullYear() + \"-\" + \n                (\"0\" + (now.getMonth()+1)).slice(-2) + \"-\" + \n                (\"0\" + now.getDate()).slice(-2) + \" \" + \n                (\"0\" + now.getHours()).slice(-2) + \":\" + \n                (\"0\" + now.getMinutes()).slice(-2) + \":\" + \n                (\"0\" + now.getSeconds()).slice(-2);\n\n// 2. Convert the incoming Array to a String\n// If msg.payload is already a string, this won't break it.\nvar dataString = typeof msg.payload === 'object' ? JSON.stringify(msg.payload) : msg.payload;\n\n// 3. Combine them into one readable line\nmsg.payload = timeStamp + \" | Data: \" + dataString;\n\n// 4. Update status so you can see it working in the editor\nnode.status({fill:\"blue\", shape:\"dot\", text: timeStamp});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1570,
        "y": 400,
        "wires": [
            [
                "43c2bff61b834d5f"
            ]
        ]
    },
