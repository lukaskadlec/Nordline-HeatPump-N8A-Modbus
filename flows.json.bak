    {
        "id": "b9266b0544516dfa",
        "type": "function",
        "z": "1c00011a6f22edfe",
        "name": "check crc",
        "func": "// 1. Get the payload\nlet buffer = msg.payload;\n\n// 2. Normalize input: Ensure it is a Buffer\nif (Array.isArray(buffer)) {\n    buffer = Buffer.from(buffer);\n}\n\n// 3. Safety Check: If it's not a buffer or too short for a Modbus frame\nif (!Buffer.isBuffer(buffer) || buffer.length < 4) {\n    node.warn(\"Input is not a valid buffer or is too short\");\n    return [null, msg]; // Output 2 (Error path)\n}\n\n// --- Helper Functions ---\n\n// Calculate Modbus RTU CRC16 (poly 0xA001, init 0xFFFF)\nfunction calculateCRC(buf, length) {\n    let crc = 0xFFFF;\n    for (let pos = 0; pos < length; pos++) {\n        crc ^= buf[pos];\n        for (let i = 8; i !== 0; i--) {\n            if ((crc & 0x0001) !== 0) {\n                crc = (crc >> 1) ^ 0xA001;\n            } else {\n                crc >>= 1;\n            }\n        }\n    }\n    return crc;\n}\n\n// Verify CRC against the last two bytes of a buffer slice\nfunction isCrcValid(buf) {\n    if (!buf || buf.length < 5) return false; // Minimum Modbus frame is 5 bytes (exception)\n    const crc = calculateCRC(buf, buf.length - 2);\n    const low = crc & 0xFF;\n    const high = (crc >> 8) & 0xFF;\n    return low === buf[buf.length - 2] && high === buf[buf.length - 1];\n}\n\n// Protocol-aware stream slicer\nfunction extractModbusFrames(buf) {\n    const validFrames = [];\n    let offset = 0;\n\n    while (offset <= buf.length - 5) {\n        let matched = false;\n        const remaining = buf.length - offset;\n        const fc = buf[offset + 1];\n\n        // Predict expected frame lengths based on Modbus function code\n        const candidateLengths = [];\n\n        if (fc >= 0x81 && fc <= 0x8F) {\n            // Exception response: [Slave, FC|0x80, ExCode, CRCLow, CRCHigh] = 5 bytes\n            candidateLengths.push(5);\n        } else if (fc >= 1 && fc <= 4) {\n            // Request: [Slave, FC, AddrHi, AddrLo, QtyHi, QtyLo, CRCLow, CRCHigh] = 8 bytes\n            candidateLengths.push(8);\n            // Response: [Slave, FC, ByteCount(N), Data(N), CRCLow, CRCHigh] = N + 5 bytes\n            if (remaining >= 3) {\n                const byteCount = buf[offset + 2];\n                candidateLengths.push(byteCount + 5);\n            }\n        } else if (fc === 5 || fc === 6) {\n            // Write Single Coil / Register (both Req and Resp are 8 bytes)\n            candidateLengths.push(8);\n        } else if (fc === 15 || fc === 16) {\n            // Response: 8 bytes\n            candidateLengths.push(8);\n            // Request: [Slave, FC, Addr(2), Qty(2), ByteCount(N), Data(N), CRC(2)] = N + 9 bytes\n            if (remaining >= 7) {\n                const byteCount = buf[offset + 6];\n                candidateLengths.push(byteCount + 9);\n            }\n        }\n\n        // Test predicted protocol lengths first\n        for (const len of candidateLengths) {\n            if (len >= 5 && len <= remaining) {\n                const slice = buf.subarray(offset, offset + len);\n                if (isCrcValid(slice)) {\n                    validFrames.push(Buffer.from(slice));\n                    offset += len;\n                    matched = true;\n                    break;\n                }\n            }\n        }\n\n        // Fallback: Sliding search for any valid CRC frame if FC prediction missed\n        if (!matched) {\n            for (let len = 5; len <= remaining; len++) {\n                if (candidateLengths.includes(len)) continue;\n                const slice = buf.subarray(offset, offset + len);\n                if (isCrcValid(slice)) {\n                    validFrames.push(Buffer.from(slice));\n                    offset += len;\n                    matched = true;\n                    break;\n                }\n            }\n        }\n\n        // If no valid frame starts at current byte, shift by 1 to skip noise/idle bytes\n        if (!matched) {\n            offset++;\n        }\n    }\n\n    return validFrames;\n}\n\n// 4. Initial Check: Is the entire message already a single valid frame?\nif (isCrcValid(buffer)) {\n    msg.payload = buffer;\n    msg.crc_status = \"valid\";\n    msg.is_split = false;\n    return [msg, null];\n}\n\n// 5. CRC Failed: Attempt to carve out multiple concatenated Modbus frames\nconst frames = extractModbusFrames(buffer);\n\nif (frames.length > 0) {\n    // Generate an individual msg object for each extracted frame\n    const outputMessages = frames.map((frame, index) => {\n        const newMsg = (typeof RED !== \"undefined\" && RED.util && RED.util.cloneMessage) \n            ? RED.util.cloneMessage(msg) \n            : Object.assign({}, msg);\n            \n        newMsg.payload = frame;\n        newMsg.crc_status = \"valid\";\n        newMsg.is_split = true;\n        newMsg.frame_index = index;\n        newMsg.frame_count = frames.length;\n        return newMsg;\n    });\n\n    // Returning an array of messages sends them sequentially to Output 1\n    return [outputMessages, null];\n} else {\n    // 6. No valid frame could be recovered: Route to Output 2 (Error path)\n    const crc = calculateCRC(buffer, buffer.length - 2);\n    msg.crc_status = \"invalid\";\n    msg.expected_crc = [crc & 0xFF, (crc >> 8) & 0xFF];\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
